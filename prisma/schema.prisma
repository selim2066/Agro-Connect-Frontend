// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums — per database-rules.md: use Prisma enums for all fixed values
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerPlan {
  FREE
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum ReviewType {
  PRODUCT
  WHOLESALE_SHOP
  WHOLESALE_BUYER
}

// ─────────────────────────────────────────────────────────────────────────────
// Models will be added here during module implementation.
// This schema establishes the enum foundation per database-rules.md.
// ─────────────────────────────────────────────────────────────────────────────
